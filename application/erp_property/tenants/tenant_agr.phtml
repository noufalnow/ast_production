<td colspan="12">

<div class="lease-grid">

<?php foreach ($this->leaseDocs as $doc):

$doiObj = DateTime::createFromFormat(DFS_DB,$doc['doc_issue_date']);
$doeObj = DateTime::createFromFormat(DFS_DB,$doc['doc_expiry_date']);

$doi = $doiObj->format(DF_DD);
$doe = $doeObj->format(DF_DD);

$today = new DateTime();

$status = ($doeObj < $today) ? 'Expired' : 'Active';

$daysRemaining = ($doeObj >= $today)
    ? $today->diff($doeObj)->days
    : 0;

$rentDue = $doc['to_collect'] - $doc['collected'];

$encFileId = $this->encode($doc['file_id']);
$encDocId1 = $this->encode($doc['doc_id']);
$encPropId = $this->encode($doc['prop_id']);

?>

<div class="lease-card">




    <div class="lease-header">

        <strong>
        <?=x([
            'link'=>'erp_property/master/view',
            'ref'=>$encPropId,
            'label'=>$doc['prop_fileno']
        ])?>
        </strong>

        <span class="lease-doc">
        <?=x([
            'link'=>'erp_property/master/propdocsview',
            'ref'=>$encDocId1,
            'label'=>$doc['doc_no'],
            ["param"=>'class="facebox"']
        ])?>
        </span>

    </div>


    <div class="lease-body">

        <div class="lease-row">
            <span class="label">Rent</span>
            <span class="value"><?=number_format($doc['agr_rent'],2)?></span>
        </div>

        <div class="lease-row">
            <span class="label">Start</span>
            <span class="value"><?=$doi?></span>
        </div>

        <div class="lease-row">
            <span class="label">End</span>
            <span class="value"><?=$doe?></span>
        </div>

        <div class="lease-row">
            <span class="label">Remaining</span>
            <span class="value">

            <?php if($status=='Active'): ?>
                <?=$daysRemaining?> days
            <?php else: ?>
                <span class="text-danger">Expired</span>
            <?php endif; ?>

            </span>
        </div>


        <div class="lease-row">

            <span class="label">Schedule</span>

            <span class="value">

            <?=x([
                'link'=>'erp_property/master/payoptions',
                'ref'=>$encDocId1,
                'label'=>'<i class="glyphicon glyphicon-usd text-info"></i>',
                ["param"=>'class="facebox"']
            ])?>

            </span>

        </div>


        <?php if($doc['to_collect']): ?>

        <div class="lease-row">

            <span class="label">Payments</span>

            <span class="value">

            <?=x([
                'link'=>'erp_property/tenants/tenant_payments',
                'ref'=>$encDocId1,
                'label'=>"<b>".$doc['collected']." / ".$doc['to_collect']."</b>",
                ["param"=>'class="facebox"']
            ])?>

            </span>

        </div>

        <?php endif; ?>


        <div class="lease-row">

            <span class="label">Balance</span>

            <span class="value">

            <?php if($rentDue > 0): ?>

                <span class="badge bg-danger">
                    <?=number_format($rentDue,2)?>
                </span>

            <?php else: ?>

                <span class="badge bg-success">
                    Clear
                </span>

            <?php endif; ?>

            </span>

        </div>


    </div>


<div class="lease-actions">

    <!-- STATUS -->
    <span class="lease-status <?=$status=='Active'?'status-active':'status-expired'?>">
        <?=$status?>
    </span>

    <?=x([
        'link'=>'default/default/download',
        'ref'=>$encFileId,
        'label'=>'<i class="fas fa-search" title="View"></i>',
        ["exten"=>$doc['file_exten']]
    ])?>

    <?=x([
        'link'=>'default/default/download',
        'ref'=>$encFileId,
        'label'=>'<i class="glyphicon glyphicon-download-alt text-info" title="Download"></i>',
        ["param"=>'opener']
    ])?>

</div>

</div>

<?php endforeach ?>

</div>

</td>