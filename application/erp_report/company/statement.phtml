<?php
// =========================
// DATA PROCESSING (NO DATA LOSS)
// =========================

$incomeData = $this->financialRevanew;
$expenseData = $this->financialExpense;

$combinedData = [];

// Merge income
foreach ($incomeData as $income) {
    $key = $income['comp_id'] . '-' . $income['ref_source'];
    $combinedData[$key] = [
        'comp_id' => $income['comp_id'],
        'type' => strtolower($income['ref_source']),
        'income' => $income['total_income'],
        'expense' => 0
    ];
}

// Merge expense
foreach ($expenseData as $expense) {
    $key = $expense['comp_id'] . '-' . $expense['ref_source'];

    if (isset($combinedData[$key])) {
        $combinedData[$key]['expense'] = $expense['total_expense'];
    } else {
        $combinedData[$key] = [
            'comp_id' => $expense['comp_id'],
            'type' => strtolower($expense['ref_source']),
            'income' => 0,
            'expense' => $expense['total_expense']
        ];
    }
}

// =========================
// BUILD REPORT STRUCTURE
// =========================

$report = [];

foreach ($combinedData as $row) {

    $compId = $row['comp_id'];
    $type   = $row['type'];

    if (!isset($report[$compId])) {
        $report[$compId] = [
            'name' => $this->compList[$compId],
            'income' => 0,
            'expense' => 0,
            'segments' => []
        ];
    }

    $income  = $row['income'] ?? 0;
    $expense = $row['expense'] ?? 0;

    $report[$compId]['income'] += $income;
    $report[$compId]['expense'] += $expense;

    // Segment totals
    $report[$compId]['segments'][$type]['income']  = $income;
    $report[$compId]['segments'][$type]['expense'] = $expense;

    // DETAILS
    if ($type == 'vehicle') {
        $report[$compId]['segments'][$type]['income_details'] =
            $this->collectionObj->getVehicleRevenueByCompany([
                'f_monthpick'=>$this->f_monthval,
                'vhl_company'=>$compId
            ]);

        $report[$compId]['segments'][$type]['expense_details'] =
            $this->expenseObj->getVehicleExpenseByCompany([
                'f_monthpick'=>$this->f_monthval,
                'f_company'=>$compId
            ]);
    }

    if ($type == 'property') {
        $report[$compId]['segments'][$type]['income_details'] =
            $this->collectionObj->getPropertyRevenueByBuilding([
                'f_monthpick'=>$this->f_monthval,
                'bld_comp'=>$compId
            ]);

        $report[$compId]['segments'][$type]['expense_details'] =
            $this->expenseObj->getPropertyExpenseByCompany([
                'f_monthpick'=>$this->f_monthval,
                'f_company'=>$compId
            ]);
    }

    if ($type == 'other') {
        $report[$compId]['segments'][$type]['income_details'] = [];

        $report[$compId]['segments'][$type]['expense_details'] =
            $this->expenseObj->getOtherExpenseByCompany([
                'f_monthpick'=>$this->f_monthval,
                'f_company'=>$compId
            ]);
    }
}
?>






