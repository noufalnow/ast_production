                        if ($comp['doc_id']) {
                            $encFileId = $this->encode($comp['file_id']);
                            $encId = $this->encode($comp['doc_id']);
                        }

                        // expiry check (SAFE — no logic interference)
                        $isExpired = false;
                        $isExpiringSoon = false;
                        
                        if (!empty($comp['doc_expiry_date'])) {
                            $expiryObj = DateTime::createFromFormat('d/m/Y', $comp['doc_expiry_date']);
                            
                            if ($expiryObj) {
                                $today = new DateTime('today');
                                $warningDate = (clone $today)->modify('+7 days');
                                
                                if ($expiryObj < $today) {
                                    $isExpired = true;
                                } elseif ($expiryObj <= $warningDate) {
                                    $isExpiringSoon = true;
                                }
                            }
                        }

                        if ($temp == '' || $temp != $comp['comp_id']): ?>
                            <tr>
                                <th colspan="7"><?=$comp['comp_name']?></th>
                            </tr>
                        <?php endif; ?>

                        <tr onclick="getContentX('<?=APPURL.'erp_manage/company/'?>docversion','<?=$encId;?>','doc_target_<?=$comp['doc_id'];?>');"
                            style="cursor: pointer;">

                            <td class="center"><?=@++$offset;?></td>
                            <td><?=$comp['doc_dyn_label']?></td>
                            <td><?=$comp['doc_no']?></td>
                            <td><?=$comp['doc_issue_date']?></td>

                            <!-- ✅ expiry highlight -->
                            <td class="center <?=
