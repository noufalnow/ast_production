<script type="text/javascript">
function getContentX(postlink, refId, target) {

	if ($('#'+target).html().trim() === "") {
	    $('.doc_target').html('');
		getContent(postlink, refId, target);
	}
	else
		$('#'+target).html('');
}
</script>
